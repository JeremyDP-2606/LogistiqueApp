# ---------------------------------------------------------------------------
# API Wabap : copier en .env (ou variables d'environnement du conteneur)
# ---------------------------------------------------------------------------
PORT=4000
# Adresse publique (liens de fichiers en stockage local)
PUBLIC_URL=https://api.wabap.fr
# Origines autorisées (CORS) : back-offices. Vide = toutes (développement uniquement)
CORS_ORIGINS=https://backoffice.wabap.fr,https://bo.wabap.fr
AWS_REGION=us-east-1

# --- Données : tables DynamoDB existantes <Modèle><suffixe> ---------------
STORE=dynamodb
# Production : -nfdn7djf2fcbdjz44rvjidtaf4-prod · dev : -zjcggzi525bflmgm35w7dji5ui-dev (à vérifier dans la console)
DYNAMODB_TABLE_SUFFIX=-nfdn7djf2fcbdjz44rvjidtaf4-prod
# DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB local

# --- Authentification Cognito (pool existant) ------------------------------
AUTH_MODE=cognito
COGNITO_USER_POOL_ID=us-east-1_c5SbPwJEZ
# Applications clientes autorisées (app mobile, back-offices), séparées par des virgules
COGNITO_CLIENT_IDS=6g7521kgouj9fjsg9aibi4h650,1lq36a8msee59bdp7kek0sefsk

# --- Fichiers et e-mails ----------------------------------------------------
# Bucket S3 des preuves et étiquettes (sans bucket : dossier local FILES_DIR)
S3_BUCKET=wabap-…-prod
SENDER_EMAIL=noreply@wabap.fr
REPORT_SENDER=rapport@wabap.fr
IMPORT_REPORT_EMAILS=wabapsas@gmail.com,julien@wabap.fr,lainy@wabap.fr
IMPORT_ERROR_EMAILS=wabapsas@gmail.com,julien@wabap.fr,lainy@wabap.fr
TOURNEE_REPORT_EMAILS=

# --- Secrets des services externes (gestionnaire de secrets du conteneur) -
GOOGLE_MAPS_API_KEY=
ROUTEXL_AUTH=
STRIPE_SECRET_KEY=
LABEL_SIGNING_SECRET=

# --- Tâches planifiées : une seule instance doit les exécuter ---------------
SCHEDULER_ENABLED=true
LABELS_CRON=*/30 * * * *
# Imports SFTP planifiés (JSON) :
# SFTP_IMPORTS=[{"cron":"0 4 * * *","timezone":"America/Martinique","clientName":"France-Antilles","host":"…","port":22,"username":"…","password":"…","filename":"[ABONNES_]YYYYMMDD[.csv]"}]

# --- Bascule depuis Amplify (voir docs/MIGRATION.md) -------------------------
# false tant que les anciennes Lambda de flux DynamoDB / règles EventBridge Mission_* sont actives
V1_TRIGGERS=true
MISSION_SCHEDULER=true

# --- Règles métier ------------------------------------------------------------
TZ_OFFSET_MINUTES=-240
DISTANCE_ALERT_METERS=200
MAX_ADD_DETOUR_KM=3
