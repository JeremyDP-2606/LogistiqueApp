# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Amplify build artifacts (generated by Amplify CLI)
# The #current-cloud-backend directory is entirely generated and should not be committed
amplify/#current-cloud-backend/

# Ignore build directories (these contain generated CloudFormation templates)
amplify/**/build/

# Note: Source code in amplify/backend/function/*/src/ IS needed for CodeMagic deployment
# Config files in amplify/backend/ and amplify/cli.json are also needed
# Secrets locaux
ios/Flutter/Secrets.xcconfig
lib/amplifyconfiguration.dart
